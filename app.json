{
  "expo": {
    "name": "Truco-Play",
    "slug": "trucoplay",
    "scheme": "trucoplay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f172a",
    "splash": {
      "backgroundColor": "#0f172a"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.imoliveira.mobiletruco",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.imoliveira.mobiletruco",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      }
    },
    "extra": {
      "eas": {
        "projectId": "ae9298bb-9813-4786-a526-a7852f4e256c"
      }
    },
    "owner": "ivanzitos-team",
    "plugins": [
      "@react-native-google-signin/google-signin"
    ]
  }
}
